{
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/comerse-una-flor.html",
      "destination": "/doblar-una-flor.html",
      "permanent": true
    },
    {
      "source": "/en/comerse-una-flor.html",
      "destination": "/en/doblar-una-flor.html",
      "permanent": true
    },
    {
      "source": "/paisaje-interior.html",
      "destination": "/tienda.html",
      "permanent": true
    },
    {
      "source": "/en/paisaje-interior.html",
      "destination": "/en/tienda.html",
      "permanent": true
    }
  ]
}
